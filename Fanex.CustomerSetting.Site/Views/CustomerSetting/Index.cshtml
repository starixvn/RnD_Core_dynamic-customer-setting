@{
    Layout = null;
}
<!DOCTYPE html>
<html data-ng-app="customerSettingApp">
<head>
    <title>{{title}}</title>
    <link href="../../app/customerSetting/customer-setting.less" rel="stylesheet" type="text/css" />
</head>
<body data-ng-controller="CustomerSettingViewController">
    <div class="customer-setting" data-ng-cloak>
        <div class="message" data-ng-class="messageClass" data-ng-show="hasMessage" data-ng-bind-html="message">
        </div>
        <div data-ng-include="view">
        </div>
        <div data-customer-setting-tooltip>
        </div>
    </div>
    <script src="/app/angular-1.2.28.js" type="text/javascript"></script>
    @Scripts.Render("~/customer-setting")
</body>
</html>