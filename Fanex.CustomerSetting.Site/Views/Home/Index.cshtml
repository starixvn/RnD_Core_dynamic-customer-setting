@using Fanex.CustomerSetting.Site.UserLogin
@using Newtonsoft.Json
@model LoginViewModel
@section css{
    <link href="/Views/Home/Content/index.css" rel="stylesheet" type="text/css" />
}
@section scripts{
    <script src="/app/angular-1.2.28.min.js" type="text/javascript"></script>
    <script src="/Views/Home/Scripts/index.js" type="text/javascript"></script>
}
<div data-ng-app="indexModule" data-ng-controller="IndexController" data-ng-cloak>
    <div class="container left">
        <span ng-init="LoginForm = @Html.Raw(JsonConvert.SerializeObject(Model))"></span>
        <div class="login-form">
            @Html.Partial("_LoginForm")
        </div>
        <div ng-show="LoginForm.HideForm">
            <h4>
                Customer Setting
            </h4>
            <strong>ProductId:</strong>
            <input type="text" data-ng-model="productId" />
            <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingOne">
                        <h4 class="panel-title">
                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">Company edit
                                Super </a>
                        </h4>
                    </div>
                    <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel">
                        <div class="panel-body">
                            SuperId:
                            <input type="text" data-ng-model="superId" />
                            <a target="setting-page" data-ng-href="/CustomerSetting/#/editSuper/{{superId}}/{{productId}}">
                                Open</a>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab" id="headingTwo">
                        <h4 class="panel-title">
                            <a class="collapsed" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                                Super edit Master</a>
                        </h4>
                    </div>
                    <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel">
                        <div class="panel-body">
                            MasterId:
                            <input type="text" data-ng-model="masterId" />
                            <a target="setting-page" data-ng-href="/CustomerSetting/#/editMaster/{{masterId}}/{{productId}}">
                                Open</a>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab">
                        <h4 class="panel-title">
                            <a class="collapsed" data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                                Master edit Agent </a>
                        </h4>
                    </div>
                    <div id="collapseThree" class="panel-collapse collapse" role="tabpanel">
                        <div class="panel-body">
                            AgentId:
                            <input type="text" data-ng-model="agentId" />
                            <a target="setting-page" data-ng-href="/CustomerSetting/#/editAgent/{{agentId}}/{{productId}}">
                                Open</a>
                        </div>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-heading" role="tab">
                        <h4 class="panel-title">
                            <a class="collapsed" data-toggle="collapse" data-parent="#accordion" href="#collapseFour">
                                Super edit Member </a>
                        </h4>
                    </div>
                    <div id="collapseFour" class="panel-collapse collapse" role="tabpanel">
                        <div class="panel-body">
                            SuperId:
                            <input type="text" data-ng-model="superId" />
                            <div class="separator">
                            </div>
                            MemberId:
                            <input type="text" data-ng-model="memberId" />
                            <a target="setting-page" data-ng-href="/CustomerSetting/#/editMember/{{memberId}}/{{productId}}">
                                Open</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="main">
        <iframe name="setting-page" src="~/Home/Welcome"></iframe>
    </div>
</div>