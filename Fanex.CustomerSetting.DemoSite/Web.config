    <add key="Fanex.Logging:DefaultCategory" value="DCS-Setting-API-LOCAL" />
    <add key="Fanex.Logging:RabbitMQConnectionStrings" value="host=rabbitmq.nexdev.net;virtualHost=/Fanex_Logging;username=fanexlogging;password=YKQrMtla7oYZGlP8apPtSw==" />
