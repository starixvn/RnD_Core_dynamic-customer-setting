<#@ template debug="true" hostSpecific="true" #>
<#@ output extension=".js" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Data" #>
<#@ assembly name="System.Data.Entity" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq"#>
<#@ assembly name="System.Windows.Forms" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Security" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Xml" #>
<#@ import namespace="System.Xml.Linq" #>
<#@ import namespace="System.Windows.Forms" #>
/*jshint -W101,-W106,-W044,-W098*/

var resources = resources || {};
<#
var solutionPath = Host.ResolveAssemblyReference("$(SolutionDir)");
var resourcePath = Path.Combine(solutionPath, "Fanex.CustomerSetting.Matrix\\Resources");
var fileNames = new string[]
{
    "Label",
    "Message"
};

var templateFile = Host.TemplateFile;
var templateFileName = templateFile.Substring(templateFile.LastIndexOf('\\') + 1).Replace(".tt","");

foreach (string fileName in fileNames) 
{
    var cultureIndex = fileName.IndexOf('.');
    var culture = cultureIndex > 0 ? fileName.Substring(cultureIndex + 1) : "en-US";
    var resourceName = cultureIndex > 0 ? fileName.Substring(0, cultureIndex) : fileName;
    var language = new StringBuilder(string.Format("\r\nresources[\"{0}\"] = resources[\"{0}\"] || {{}};\r\nresources[\"{0}\"][\"{1}\"] = {{", resourceName.ToLower(), culture.ToLower()));
    var filePath = Path.Combine(resourcePath, string.Format("{0}.resx", fileName));

    if (File.Exists(filePath))
    {
        using (var stream = new FileStream(filePath, FileMode.Open, FileAccess.Read))
        {
            var xDoc = XDocument.Load(stream);
            var items = xDoc.Descendants("data").OrderBy(i => i.Attribute("name").Value);
            var index = 0;
            var lastIndex = items.Count() - 1;

            foreach (var item in items)
            {
                var isLast = index == lastIndex;
                var valueItem = item.Descendants("value").FirstOrDefault();

                language.Append(CreateJsonPropertise(item.Attribute("name").Value, valueItem.Value, isLast));
                index++;
            }

            language.Append("\r\n};");
        }

        if(language.Length > 0)
        {
#>
<#=language.ToString()#>
<#          }
    }
}
#>

<#+
string CreateJsonPropertise(string name, string value, bool isLast)
{
    var pattern = "\r\n    \"{0}\": \"{1}\"{2}";
    var separate = isLast ?  string.Empty: "," ;
    return string.Format(pattern, name, SecurityElement.Escape(value.Trim().Replace("\n", " ")), separate);
}
#>