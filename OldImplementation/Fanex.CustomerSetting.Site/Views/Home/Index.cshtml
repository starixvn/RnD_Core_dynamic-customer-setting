@using Fanex.CustomerSetting.Site.UserLogin
@using Fanex.CustomerSetting.Enumerations
@using Newtonsoft.Json
@model LoginViewModel
@{
    var rootUrl = Request.ApplicationPath;
    if (rootUrl.EndsWith("/"))
    {
        rootUrl = rootUrl.Substring(0, rootUrl.Length - 1);
    }
}
@section css{
    <link href="~/Views/Home/Content/index.css" rel="stylesheet" type="text/css" />
}
@section scripts{
    <script src="~/app/angular-1.2.28.min.js" type="text/javascript"></script>
    <script src="~/Views/Home/Scripts/index.js" type="text/javascript"></script>
}
<div id="main" data-root-url="@rootUrl" data-ng-app="indexModule" data-ng-controller="IndexController" data-ng-cloak>
