<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        
        <section name="ONEbook.NG2.API" type="ONEbook.NG2.API.Configuration.NG2Configuration, ONEbook.NG2.API" />
        <section name="LogsConfiguration" type="Fanex.Module.Logs.Mappings.LogsConfiguration, Fanex.Module.Logs" />
        <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" />
    </configSections>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    
    <ONEbook.NG2.API configSource="Configurations\ONEbook.NG2.API.config" />
    <LogsConfiguration configSource="Configurations\LogsConfiguration.config" />
    <ONEbook.UM.ThirdParty ServiceUris="http://10.18.200.124:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/UserLogin/Common/Offline">
        <Products>
            <add Id="23" IsUM="false" UMFrom="00:00" UMTo="01:00" />
            <!--For manual control on site each product -->
        </Products>
    </ONEbook.UM.ThirdParty>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="MessagePack" publicKeyToken="b4a0369545f0a1be" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.7.3.7" newVersion="1.7.3.7" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <appSettings>
    <add key="LogLibs" value="" />
  </appSettings>
</configuration>