<?xml version="1.0"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="CustomerSettingApiConfiguration" type="Fanex.CustomerSetting.WebApi.Configurations.CustomerSettingApiConfiguration, Fanex.CustomerSetting.WebApi" />
        <section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting" />
        <section name="ONEbook.NG2.API" type="ONEbook.NG2.API.Configuration.NG2Configuration, ONEbook.NG2.API" />
        <section name="LogsConfiguration" type="Fanex.Module.Logs.Mappings.LogsConfiguration, Fanex.Module.Logs" />
        <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" />
    </configSections>

    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="~/App_Data/CustomerSettingSpNames/" enableWatching="0" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.103\private$\entlib" defaultCategory="DCS-Setting-API-LOCAL" />
    <CustomerSettingApiConfiguration SecretKey="U6BUFHtVcq5SPQcTl7tHLBG/LF6d5YVRKHrCHD9M+Vw=" FanexRemotingRefService="http://ha.nexdev.net:7258/Main/" />
    <CustomerSettingConfiguration TasksConfigurationPath="App_Data\PluggableTasks" />
    <ONEbook.NG2.API configSource="App_Data\ApiConfigurations\ONEbook.NG2.API.config" />
    <LogsConfiguration configSource="App_Data\ApiConfigurations\LogsConfiguration.config" />
    <ONEbook.UM.ThirdParty ServiceUris="http://10.18.200.124:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00">
        <Products>
            <add Id="23" IsUM="false" UMFrom="00:00" UMTo="01:00" />
            <!--For manual control on site each product -->
        </Products>
    </ONEbook.UM.ThirdParty>

    <connectionStrings configSource="Web.ConnectionStrings.config" />
    <appSettings />
    <system.web>
        <compilation debug="true" targetFramework="4.6" />
        <httpRuntime targetFramework="4.6" enableVersionHeader="false" />
    </system.web>
    <system.webServer>
        <handlers>
            <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
            <remove name="OPTIONSVerbHandler" />
            <remove name="TRACEVerbHandler" />
            <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
        </handlers>
    </system.webServer>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-4.1.1.2" newVersion="4.1.1.2" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>